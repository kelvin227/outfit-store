# Copy this file to .env and fill in your own values
DATABASE_URL="postgresql://postgres:password@localhost:5432/outfit_store"

# Shown in the header and browser tab
NEXT_PUBLIC_STORE_NAME="Your Store Name"

# Your friend's WhatsApp number: country code + number, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"

# Admin panel login (visit /admin). Pick a strong password.
ADMIN_PASSWORD="choose-a-strong-password"
# Any long random text. It makes the login cookie harder to fake.
ADMIN_SECRET="type-a-long-random-sentence-here"
